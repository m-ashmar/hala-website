# ─────────────────────────────────────────────────────────────────────────────
# Halahello — environment configuration
#
# Copy to `.env.local` for development:   cp .env.example .env.local
#
# Variables marked [REQUIRED IN PROD] are enforced by lib/env.ts when
# NODE_ENV=production. The app will refuse to boot without them — this is
# deliberate: several security controls previously disabled themselves
# silently when their secret was absent.
# ─────────────────────────────────────────────────────────────────────────────


# ── Core infrastructure ──────────────────────────────────────────────────────

# [REQUIRED — always] PostgreSQL connection string.
# On a pooled provider (Supabase/Neon) this is the pooled/PgBouncer URL.
DATABASE_URL="postgresql://user:password@localhost:5432/halahello"

# [REQUIRED — always] Direct (non-pooled) connection, used by Prisma for
# migrations. On a single local Postgres this is the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/halahello"

# [REQUIRED IN PROD] Vercel Blob storage token — used for custom-request uploads.
BLOB_READ_WRITE_TOKEN=""


# ── Authentication ───────────────────────────────────────────────────────────

# [REQUIRED — always] Session signing secret. Generate with:
#   openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is the legacy v4 name and is
# still accepted. Set at least one.
AUTH_SECRET=""

# Canonical site URL. Required in production for OAuth/Stripe redirect URLs.
NEXTAUTH_URL="http://localhost:3000"


# ── Payments: Stripe ─────────────────────────────────────────────────────────

# [REQUIRED IN PROD] Secret API key (sk_test_… in dev, sk_live_… in production).
STRIPE_SECRET_KEY=""

# [REQUIRED IN PROD] Webhook signing secret (whsec_…), from the Stripe dashboard
# or `stripe listen`. Without it, payment confirmations cannot be trusted.
STRIPE_WEBHOOK_SECRET=""


# ── Payments: ShamCash ───────────────────────────────────────────────────────

# Optional. When unset, payment verification runs in a passive mode that never
# auto-confirms an order — safe, but orders must be confirmed manually.
SHAMCASH_API_TOKEN=""
SHAMCASH_ACCOUNT_ID=""

# Minutes a pending order stays open awaiting payment. Default: 60
SHAMCASH_POLL_TIMEOUT_MINUTES="60"

# Number shown to the customer on the payment instructions screen.
NEXT_PUBLIC_SHAMCASH_DISPLAY_NUMBER=""


# ── CMS: Sanity ──────────────────────────────────────────────────────────────

# [REQUIRED IN PROD] Project ID from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# [REQUIRED IN PROD] Usually "production".
NEXT_PUBLIC_SANITY_DATASET="production"

# API version pin. Default: 2026-07-07
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-07"

# [REQUIRED IN PROD] HMAC secret for /api/webhooks/sanity. That endpoint writes
# prices, stock, order status and coupons into Postgres — an unsigned request
# is now rejected outright rather than trusted.
SANITY_WEBHOOK_SECRET=""

# Write token (Editor+). Needed for Postgres → Sanity sync.
SANITY_API_TOKEN=""


# ── Authentication: WhatsApp OTP ─────────────────────────────────────────────

# [REQUIRED IN PROD] Without these the OTP endpoint refuses to issue codes.
# It must never fall back to a fixed code — that is a full auth bypass.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# Provider: meta | twilio | 360dialog   (default: meta)
WHATSAPP_PROVIDER="meta"

# Development only. Uses the fixed code 123456 and prints it to the server log.
# Rejected outright when NODE_ENV=production.
WHATSAPP_MOCK="true"


# ── Email (Resend) ───────────────────────────────────────────────────────────

# Optional. When unset, emails are logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Halahello <noreply@halahello.com>"

# Destination for contact-form and custom-request notifications.
ADMIN_EMAIL=""


# ── Scheduled jobs ───────────────────────────────────────────────────────────

# [REQUIRED IN PROD] Shared secret for /api/cron/expire-orders, which cancels
# unpaid orders past their payment window. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. The route mutates order state, so in
# production it refuses to run when this is unset. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""


# ── Integrations ─────────────────────────────────────────────────────────────

# Optional. When unset the Instagram feed renders static fallback images.
INSTAGRAM_ACCESS_TOKEN=""


# ── Site ─────────────────────────────────────────────────────────────────────

# Public base URL — used for sitemap/canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Display currency code. Default: SYP
# NOTE: see PRODUCTION_READINESS_PLAN.md item 1.1 — the Stripe charge currency
# is a separate, currently unresolved concern.
NEXT_PUBLIC_CURRENCY="SYP"
